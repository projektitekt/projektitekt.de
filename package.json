{
	"name": "projektitekt",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:smoke": "playwright test",
		"snapshot": "node scripts/snapshot.mjs"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/canvas-confetti": "1.9.0",
		"@types/node": "26.6.6",
		"@types/showdown": "2.0.6",
		"canvas-confetti": "1.9.4",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.14.0",
		"playwright": "1.65.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"showdown": "2.1.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"valibot": "1.5.0",
		"vite": "8.3.5",
		"vitest": "4.1.12",
		"yaml": "2.9.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^12.1.0",
			"onFail": "download"
		}
	}
}
